<?xml version="1.0" encoding="UTF-8"?>
<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/"
                xmlns:pb="urn:aasaanpay:payments">

  <soap:Body>
    <soap:Fault>
      <faultcode>soap:Client</faultcode>
      <faultstring>Charge declined by issuing bank</faultstring>
      <detail>
        <pb:error>
          <code>TXN_DECLINED</code>
          <description>The issuing bank declined this charge and no funds were captured.</description>
        </pb:error>
      </detail>
    </soap:Fault>
  </soap:Body>

</soap:Envelope>
